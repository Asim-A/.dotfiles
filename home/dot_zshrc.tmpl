VOLTA_HOME="$HOME/.volta"
export VOLTA_HOME
export PATH="$HOME/.local/bin:$VOLTA_HOME/bin:$PATH"

{{ if eq .chezmoi.os "darwin" }}
if [[ -x "/opt/homebrew/bin/brew" ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi
{{ end }}

# set the directory we want to store zinit and plugins
ZINIT_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}/zinit/zinit.git"

# download Zinit, if it's not there yet
if [[ ! -r "$ZINIT_HOME/zinit.zsh" ]]; then
  mkdir -p "$(dirname "$ZINIT_HOME")"
  if command -v git >/dev/null 2>&1; then
    git clone https://github.com/zdharma-continuum/zinit.git "$ZINIT_HOME" ||
      print -u2 "Zinit installation failed; continuing without Zinit plugins."
  else
    print -u2 "git is unavailable; continuing without Zinit plugins."
  fi
fi

if [[ -r "$ZINIT_HOME/zinit.zsh" ]]; then
  source "$ZINIT_HOME/zinit.zsh"

  # zinit is kept for zsh plugins only - the prompt itself is Starship.
  zinit light zsh-users/zsh-syntax-highlighting
  zinit light zsh-users/zsh-completions
  zinit light zsh-users/zsh-autosuggestions

  zinit snippet OMZL::git.zsh
  zinit snippet OMZP::git
  zinit snippet OMZP::sudo
  zinit snippet OMZP::kubectl
  zinit snippet OMZP::kubectx
  zinit snippet OMZP::command-not-found
fi

# load completions
fpath=("$HOME/.zsh/completion" $fpath)
autoload -Uz compinit
for dump in "$HOME"/.zcompdump(N.mh+24); do
  compinit
done
compinit -C

autoload -Uz edit-command-line
zle -N edit-command-line
bindkey '^x^e' edit-command-line

if (( $+functions[zinit] )); then
  zinit cdreplay -q
fi

# Starship prompt (shared config: ~/.config/starship.toml)
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi

# mise prompt
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi

# keybindings
bindkey -e
# bindkey '^y' autosuggest-accept # doubt this works, but will keep it here in case I want to figure out how to make it happen
bindkey '^p' history-search-backward
bindkey '^n' history-search-forward
bindkey '^I' complete-word

# history
HISTSIZE=3000
HISTFILE=~/.zsh_history
SAVEHIST=$HISTSIZE
HISTDUP=erase
setopt appendhistory
setopt sharehistory
setopt hist_ignore_space
setopt hist_ignore_all_dups
setopt hist_save_no_dups
setopt hist_ignore_dups
setopt hist_find_no_dups

# completion styling
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*' menu no
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'ls --color $realpath'
setopt GLOB_DOTS # include dotfiles

# aliases
alias ls='ls --color'
alias grep='rg'
alias rm='trash-put'
alias python="python3"
alias pip="python3 -m pip"

alias gitssh='git config core.sshCommand "ssh -i ~/.ssh/github -F /dev/null"'

alias vim='nvim'
alias zshh='source ~/.zshrc'
alias venvinit='python3 -m venv .venv'
alias venvactivate='source .venv/bin/activate'
alias zshedit='nvim ~/.zshrc'
alias sshedit='nvim ~/.ssh'

alias cdgit='mkdir -p ~/git && cd ~/git'
alias cdssh='mkdir -p ~/.ssh && cd ~/.ssh'
alias cddot='cd "$(chezmoi source-path)"'
alias gg='gemini -p'

alias -g JQ='| jq'

{{ if eq .chezmoi.os "darwin" }}
alias cddata='cd "$HOME/Library/Application Support"'
alias -g C='| pbcopy'

export DOTNET_ROOT="/usr/local/share/dotnet"
export PATH="$PATH:$DOTNET_ROOT:$DOTNET_ROOT/tools"
{{ end }}

# shell integrations
if command -v fzf >/dev/null 2>&1; then
  if fzf_zsh="$(fzf --zsh 2>/dev/null)"; then
    eval "$fzf_zsh"
  else
    for integration in \
      /usr/share/doc/fzf/examples/completion.zsh \
      /usr/share/doc/fzf/examples/key-bindings.zsh; do
      [[ ! -r "$integration" ]] || source "$integration"
    done
  fi
  unset fzf_zsh
fi

if command -v uv >/dev/null 2>&1; then
  eval "$(uv generate-shell-completion zsh)"
fi

export MASON="$HOME/.local/share/nvim/mason"
export EDITOR="nvim"

if (( $+functions[zinit] )); then
  zinit light Aloxaf/fzf-tab
fi

# Generic local-override hook: content-free in the public repo by design.
# Anything organization/employer-specific lives in a separate private
# repo/location and is sourced from there, never referenced by name here.
[[ ! -f "$HOME/.work-profile.zsh" ]] || source "$HOME/.work-profile.zsh"
